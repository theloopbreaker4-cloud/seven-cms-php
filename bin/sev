#!/usr/bin/env php
<?php
/**
 * sev — SevenCMS command-line tool.
 *
 * Usage:
 *   php bin/sev migrate                  — run pending DB migrations
 *   php bin/sev migrate:status           — list applied + pending migrations
 *   php bin/sev migrate:rollback         — roll back the most recent batch
 *   php bin/sev plugin:list              — list discovered modules
 *   php bin/sev plugin:install <Name>    — install plugin
 *   php bin/sev plugin:enable  <Name>    — enable plugin
 *   php bin/sev plugin:disable <Name>    — disable plugin
 *   php bin/sev plugin:uninstall <Name>  — uninstall plugin
 *   php bin/sev make:plugin <Name>       — scaffold a new plugin under modules/<Name>
 *   php bin/sev make:cct <Name>          — scaffold a Content Type via SQL seed
 *   php bin/sev cache:clear              — clear app cache
 *   php bin/sev key:generate             — write a random JWT_SECRET to .env
 *   php bin/sev demo:init                — create/refresh the shared demo admin (DEMO_LOGIN/DEMO_PASSWORD)
 *   php bin/sev demo:seed                — add sample pages/posts for the demo
 *   php bin/sev demo:snapshot            — save DB + uploads as the demo baseline (storage/demo/)
 *   php bin/sev demo:reset               — restore the baseline (run hourly from cron)
 *   php bin/sev user:make-admin <email>  — promote a user to the "admin" role
 *
 * Bootstraps the same way as a web request: defines _SEVEN, loads core, env, db, classes.
 */

define('_SEVEN',   1);
define('ROOT_DIR', dirname(__DIR__));
define('DS', DIRECTORY_SEPARATOR);
chdir(ROOT_DIR);

// Composer autoloader (optional). When present, third-party packages and
// plugins shipping PSR-4 namespaces become available to the CLI as well.
if (is_file(ROOT_DIR . '/vendor/autoload.php')) require_once ROOT_DIR . '/vendor/autoload.php';

require_once ROOT_DIR . '/lib/env.class.php';
Env::load(ROOT_DIR . '/.env');
define('ENVIRONMENT', Env::get('SEVEN_ENV', 'prod'));
define('PROTOCOL', 'https://');
define('ROOT_URL', parse_url((string)Env::get('APP_URL', 'http://localhost'), PHP_URL_HOST) ?: 'localhost');

// Same lookup order as General::autoload(), resolved lazily.
foreach (glob(ROOT_DIR . '/lib/*.interface.php') ?: [] as $f) require_once $f;
spl_autoload_register(static function (string $class): void {
    $lower = strtolower($class);
    $paths = [
        ROOT_DIR . "/lib/{$lower}.class.php",
        ROOT_DIR . "/app/models/{$lower}.php",
        ROOT_DIR . "/app/models/{$class}.php",
    ];
    foreach (glob(ROOT_DIR . '/modules/*', GLOB_ONLYDIR) ?: [] as $mod) {
        $paths[] = "{$mod}/models/{$lower}.php";
        $paths[] = "{$mod}/models/{$class}.php";
        $paths[] = "{$mod}/services/{$class}.php";
    }
    $paths[] = ROOT_DIR . "/modules/{$class}/Module.php";
    foreach ($paths as $path) {
        if (is_file($path)) { require_once $path; return; }
    }
});

foreach (glob(ROOT_DIR . '/config/*.config.php') ?: [] as $f) require_once $f;
Logger::$PATH = ROOT_DIR . '/logs';

require_once ROOT_DIR . '/lib/extension/rb/rb.php';
Db::setup(
    'mysql:host=' . $dbConfig['dbHost'] . ';port=' . (int)($dbConfig['dbPort'] ?? 3306) . ';dbname=' . $dbConfig['dbname'] . ';charset=utf8mb4',
    $dbConfig['user'],
    $dbConfig['password']
);
Db::syncTimezone();
Db::applyFreeze();

// ─── Dispatch ──────────────────────────────────────────────────────────────
$cmd  = (string)($argv[1] ?? '');
$args = array_slice($argv, 2);

if (!$cmd) {
    fwrite(STDOUT, "sev — SevenCMS CLI\n\n");
    fwrite(STDOUT, "Usage: php bin/sev <command> [args]\n\n");
    fwrite(STDOUT, "  migrate, migrate:status, migrate:rollback\n");
    fwrite(STDOUT, "  plugin:list, plugin:install, plugin:enable, plugin:disable, plugin:uninstall\n");
    fwrite(STDOUT, "  make:plugin <Name>, make:cct <Name>\n");
    fwrite(STDOUT, "  user:make-admin <email>\n");
    fwrite(STDOUT, "  cache:clear, key:generate\n");
    fwrite(STDOUT, "  demo:init, demo:snapshot, demo:reset\n");
    fwrite(STDOUT, "  mail:send [--limit=N], mail:status\n");
    fwrite(STDOUT, "  cron:run, cron:list\n");
    fwrite(STDOUT, "  ecom:bill-due\n");
    fwrite(STDOUT, "  db:orphans [--drop-empty]\n");
    exit(0);
}

try {
    match ($cmd) {
        'migrate'           => cmdMigrate(),
        'migrate:status'    => cmdMigrateStatus(),
        'migrate:rollback'  => cmdMigrateRollback(),
        'plugin:list'       => cmdPluginList(),
        'plugin:install'    => cmdPluginInstall($args[0] ?? ''),
        'plugin:enable'     => cmdPluginToggle($args[0] ?? '', 'enable'),
        'plugin:disable'    => cmdPluginToggle($args[0] ?? '', 'disable'),
        'plugin:uninstall'  => cmdPluginToggle($args[0] ?? '', 'uninstall'),
        'make:plugin'       => cmdMakePlugin($args[0] ?? ''),
        'make:cct'          => cmdMakeCct($args[0] ?? ''),
        'user:make-admin'   => cmdMakeAdmin($args[0] ?? ''),
        'cache:clear'       => cmdCacheClear(),
        'key:generate'      => cmdKeyGenerate(),
        'demo:init'         => cmdDemoInit(),
        'demo:seed'         => cmdDemoSeed(),
        'demo:snapshot'     => cmdDemoSnapshot(),
        'demo:reset'        => cmdDemoReset(),
        'mail:send'         => cmdMailSend($args),
        'mail:status'       => cmdMailStatus(),
        'cron:run'          => cmdCronRun(),
        'cron:list'         => cmdCronList(),
        'ecom:bill-due'     => cmdEcomBillDue(),
        'db:orphans'        => cmdDbOrphans($args),
        default             => fail("Unknown command: {$cmd}"),
    };
} catch (\Throwable $e) {
    fwrite(STDERR, "ERROR: " . $e->getMessage() . "\n");
    if (getenv('SEV_DEBUG')) fwrite(STDERR, $e->getFile() . ':' . $e->getLine() . "\n" . $e->getTraceAsString() . "\n");
    exit(1);
}

// ─── Command bodies ────────────────────────────────────────────────────────

/**
 * Before 2026-11-20 models whose class name differed from their table (Order →
 * ecom_orders, ContentType → content_types, …) were saved by RedBean's fluid mode
 * into auto-created look-alike tables. List those; --drop-empty removes the empty ones.
 * Non-empty ones hold rows the app never read back — inspect them by hand.
 */
function cmdDbOrphans(array $args): void
{
    $stray = ['order', 'ecomcustomer', 'subscription', 'discount', 'product', 'productvariant',
              'contenttype', 'contentfield', 'contententry', 'mediafolder', 'users'];
    $drop  = in_array('--drop-empty', $args, true);
    $found = 0;
    foreach ($stray as $t) {
        if (!DB::getCell('SHOW TABLES LIKE ?', [$t])) continue;
        $found++;
        $n = (int)DB::getCell('SELECT COUNT(*) FROM `' . $t . '`');
        if ($n === 0 && $drop) {
            DB::execute('DROP TABLE `' . $t . '`');
            ok("  dropped empty `{$t}`");
        } else {
            warn("  `{$t}`: {$n} row(s)" . ($n ? ' — written by the old bug, review before dropping' : ''));
        }
    }
    if (!$found) ok('No orphan tables.');
}

function cmdMigrate(): void
{
    $r = Migrator::migrate();
    if ($r['count'] === 0 && empty($r['errors'])) {
        info('Nothing to migrate.');
        return;
    }
    foreach ($r['ran'] as $m) ok("✓ {$m}");
    foreach ($r['errors'] as $e) fail("✗ {$e['migration']}: {$e['error']}");
    ok("Applied {$r['count']} migration(s).");
}

function cmdMigrateStatus(): void
{
    $applied = array_flip(Migrator::applied());
    $pending = Migrator::pending();
    info('Applied:');
    foreach (array_keys($applied) as $m) ok("  ✓ {$m}");
    info('Pending:');
    foreach ($pending as $m) warn("  · {$m}");
    if (!$pending) ok("  (none)");
}

function cmdMigrateRollback(): void
{
    $rolled = Migrator::rollbackLastBatch();
    foreach ($rolled as $m) warn("← {$m}");
    if (!$rolled) info('Nothing to roll back.');
    else          ok("Rolled back " . count($rolled) . " migration(s). Note: tables not dropped.");
}

function cmdPluginList(): void
{
    PluginManager::ensureTable();
    $discovered = PluginManager::discover();
    $rows       = PluginManager::all();
    $byName     = [];
    foreach ($rows as $r) $byName[$r['name']] = $r;

    foreach ($discovered as $name => $class) {
        $row = $byName[$name] ?? null;
        $status = $row['status'] ?? 'uninstalled';
        $icon = match ($status) {
            'enabled'      => '✓',
            'disabled'     => '·',
            'installed'    => '○',
            default        => '×',
        };
        echo sprintf("  %s %-20s %-12s v%s\n", $icon, $name, $status, $row['version'] ?? '0.0.0');
    }
}

function cmdPluginInstall(string $name): void
{
    if ($name === '') fail('Plugin name required.');
    $r = PluginManager::install($name);
    if (!$r['ok']) fail($r['message'] ?? 'Install failed');
    ok("Installed {$name}.");
}

function cmdPluginToggle(string $name, string $action): void
{
    if ($name === '') fail('Plugin name required.');
    $r = PluginManager::$action($name);
    if (!($r['ok'] ?? false)) fail($r['message'] ?? "Failed to {$action} {$name}");
    ok(ucfirst($action) . "d {$name}.");
}

function cmdMakePlugin(string $name): void
{
    if (!preg_match('/^[A-Z][A-Za-z0-9]+$/', $name)) fail('Plugin name must be PascalCase.');
    $dir = ROOT_DIR . "/modules/{$name}";
    if (is_dir($dir)) fail("Already exists: {$dir}");

    mkdir($dir . '/controllers', 0755, true);
    mkdir($dir . '/models',      0755, true);
    mkdir($dir . '/migrations',  0755, true);

    file_put_contents("{$dir}/Module.php", <<<PHP
<?php

defined('_SEVEN') or die('No direct script access allowed');

class {$name}Module implements ModuleInterface
{
    public function getName(): string { return '{$name}'; }
    public function boot(): void {}
    public function onInstall(): void {}
    public function onEnable(): void {}
    public function onDisable(): void {}
    public function onUninstall(): void {}

    public function routes(): array
    {
        return [
            // 'admin.{$name}' => ['controller' => '{$name}', 'action' => 'index', 'prefix' => 'admin'],
        ];
    }
}

PHP);

    file_put_contents("{$dir}/plugin.json", json_encode([
        'name'        => $name,
        'version'     => '0.1.0',
        'description' => "{$name} plugin",
        'author'      => '',
        'permissions' => [],
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));

    file_put_contents("{$dir}/migrations/" . date('Y_m_d_His') . "_init.sql", "-- Initial migration for {$name}\n");

    ok("Scaffolded plugin: modules/{$name}/");
}

function cmdMakeCct(string $name): void
{
    if ($name === '') fail('Content type name required.');
    $slug = strtolower(preg_replace('~[^a-z0-9_]+~i', '_', $name));
    DB::execute(
        'INSERT IGNORE INTO content_types (slug, name, icon) VALUES (:s, :n, :i)',
        [':s' => $slug, ':n' => $name, ':i' => 'box']
    );
    ok("Created content type slug='{$slug}'. Add fields via the admin UI.");
}

function cmdMakeAdmin(string $email): void
{
    if ($email === '') fail('Email required.');
    $row = DB::findOne('user', ' email = :e ', [':e' => $email]);
    if (!$row) fail("User not found: {$email}");

    DB::execute('UPDATE user SET role = "admin" WHERE id = :id', [':id' => (int)$row['id']]);
    if (Permission::class) {
        Permission::syncRoles((int)$row['id'], array_unique(array_merge(Permission::userRoles((int)$row['id']), ['admin'])));
    }
    ok("{$email} is now an admin.");
}

/** Boot the same cache driver the web app uses (Redis when configured and reachable). */
function bootCliCache(): void
{
    global $config;
    $driver = null;
    if (($config['cache']['driver'] ?? 'file') === 'redis') {
        $r = $config['redis'] ?? [];
        $driver = new CacheRedisDriver($r['host'] ?? '127.0.0.1', (int)($r['port'] ?? 6379), $r['prefix'] ?? 'seven:');
        if (!$driver->isConnected()) $driver = null;
    }
    Cache::boot($driver ?? new CacheFileDriver());
}

function cmdCacheClear(): void
{
    bootCliCache();
    Cache::flush();
    ok('Cache cleared.');
}

function cmdMailSend(array $args): void
{
    $limit = 50;
    foreach ($args as $a) {
        if (preg_match('/^--limit=(\d+)$/', $a, $m)) $limit = (int)$m[1];
    }
    $r = Mailer::processQueue($limit);
    ok("Processed {$r['processed']}, sent {$r['sent']}, failed {$r['failed']}.");
}

function cmdMailStatus(): void
{
    $s = Mailer::stats();
    info('Mail queue:');
    ok("  pending  {$s['pending']}");
    ok("  sending  {$s['sending']}");
    ok("  sent     {$s['sent']}");
    warn("  failed   {$s['failed']}");
}

function cmdCronRun(): void
{
    $r = CronRunner::runDue();
    if (!$r['ran']) { info('No jobs due.'); return; }
    foreach ($r['ran'] as $j) ok("✓ {$j['name']} ({$j['ms']}ms)");
    foreach ($r['errors'] as $e) fail("✗ {$e['name']}: {$e['error']}");
}

function cmdCronList(): void
{
    foreach (CronRunner::list() as $j) {
        $next = $j['next_run_at'] ?? '—';
        $last = $j['last_run_at'] ?? '—';
        echo sprintf("  %-30s %-15s last=%s next=%s\n",
            $j['name'], $j['schedule'], $last, $next);
    }
}

function cmdEcomBillDue(): void
{
    if (!class_exists('SubscriptionBiller')) { warn('Ecom plugin not enabled.'); return; }
    $r = SubscriptionBiller::billDue();
    ok("Billed {$r['billed']} subscription(s); {$r['failed']} failed.");
}

// ─── pretty output helpers ────────────────────────────────────────────────

function info(string $m): void { fwrite(STDOUT, $m . "\n"); }
function ok  (string $m): void { fwrite(STDOUT, "\033[32m{$m}\033[0m\n"); }
function warn(string $m): void { fwrite(STDOUT, "\033[33m{$m}\033[0m\n"); }
function fail(string $m): void { fwrite(STDERR, "\033[31m{$m}\033[0m\n"); exit(1); }

function cmdKeyGenerate(): void
{
    $file = ROOT_DIR . '/.env';
    $env  = is_file($file) ? (string)file_get_contents($file) : '';
    if (preg_match('/^JWT_SECRET=\S{32,}/m', $env)) { warn('JWT_SECRET already set — leaving it (rotating logs everyone out).'); return; }

    $line = 'JWT_SECRET=' . bin2hex(random_bytes(32));
    $env  = preg_match('/^JWT_SECRET=.*$/m', $env)
        ? preg_replace('/^JWT_SECRET=.*$/m', $line, $env)
        : rtrim($env) . "\n" . $line . "\n";
    file_put_contents($file, $env);
    ok('JWT_SECRET written to .env');
}

// ─── Demo instance ─────────────────────────────────────────────────────────

function demoDir(): string
{
    $dir = ROOT_DIR . '/storage/demo';
    if (!is_dir($dir)) mkdir($dir, 0750, true);
    return $dir;
}

/** Run a mysql/mysqldump command with the password passed via env, not argv. */
function runMysqlTool(string $tool, array $args, ?string $stdinFile = null, ?string $stdoutFile = null): void
{
    global $dbConfig;
    $cmd = array_merge(
        [$tool, '-h', (string)$dbConfig['dbHost'], '-P', (string)($dbConfig['dbPort'] ?? 3306), '-u', (string)$dbConfig['user']],
        $args,
        [(string)$dbConfig['dbname']]
    );
    $spec = [
        0 => $stdinFile  ? ['file', $stdinFile, 'r']  : ['pipe', 'r'],
        1 => $stdoutFile ? ['file', $stdoutFile, 'w'] : ['pipe', 'w'],
        2 => ['pipe', 'w'],
    ];
    $env  = array_merge(getenv(), ['MYSQL_PWD' => (string)$dbConfig['password']]);
    $proc = proc_open($cmd, $spec, $pipes, ROOT_DIR, $env);
    if (!is_resource($proc)) fail("Cannot start {$tool}");
    $err = isset($pipes[2]) ? stream_get_contents($pipes[2]) : '';
    foreach ($pipes as $p) fclose($p);
    if (proc_close($proc) !== 0) fail("{$tool} failed: " . trim((string)$err));
}

function copyTree(string $from, string $to): void
{
    if (!is_dir($from)) return;
    if (!is_dir($to)) mkdir($to, 0755, true);
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($from, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::SELF_FIRST);
    foreach ($it as $item) {
        $target = $to . '/' . substr($item->getPathname(), strlen($from) + 1);
        $item->isDir() ? (is_dir($target) || mkdir($target, 0755, true)) : copy($item->getPathname(), $target);
    }
}

/** Empty public/uploads but keep its protective .htaccess and index.html. */
function clearUploads(): void
{
    $root = ROOT_DIR . '/public/uploads';
    if (!is_dir($root)) return;
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::CHILD_FIRST);
    foreach ($it as $item) {
        $rel = substr($item->getPathname(), strlen($root) + 1);
        if (in_array($rel, ['.htaccess', 'index.html'], true)) continue;
        $item->isDir() ? @rmdir($item->getPathname()) : unlink($item->getPathname());
    }
}

function cmdDemoInit(): void
{
    if (!Demo::enabled()) fail('Set DEMO_MODE=true in .env first.');
    ok('Demo admin ready: ' . ensureDemoUser());
}

/** Create or repair the shared demo login; returns its email. Idempotent. */
function ensureDemoUser(): string
{
    $email = strtolower(Demo::login());
    $hash  = password_hash(Demo::password(), PASSWORD_BCRYPT, ['cost' => 10]);
    $row   = DB::findOne('user', ' email = :e ', [':e' => $email]);
    if ($row) {
        DB::execute('UPDATE user SET password = :p, role = "admin", is_active = 1 WHERE id = :id', [':p' => $hash, ':id' => (int)$row['id']]);
    } else {
        // `user` is created by RedBean's fluid mode, so optional columns (provider, …)
        // only exist once something wrote them — insert just the ones that are there.
        $now  = date('Y-m-d H:i:s');
        $want = ['first_name' => 'Demo', 'last_name' => 'Admin', 'user_name' => 'demo', 'email' => $email,
                 'password' => $hash, 'role' => 'admin', 'is_active' => 1, 'provider' => 'local',
                 'created_at' => $now, 'updated_at' => $now];
        $cols = array_map(fn($r) => $r['Field'], DB::getAll('SHOW COLUMNS FROM user'));
        $data = array_intersect_key($want, array_flip($cols));
        DB::execute(
            'INSERT INTO user (`' . implode('`, `', array_keys($data)) . '`) VALUES (' . implode(', ', array_fill(0, count($data), '?')) . ')',
            array_values($data)
        );
    }
    if (!DB::getCell('SELECT id FROM user WHERE email = ?', [$email])) fail("Could not create the demo user {$email}.");
    return $email;
}

function cmdDemoSnapshot(): void
{
    $dir = demoDir();
    runMysqlTool('mysqldump', ['--single-transaction', '--skip-lock-tables', '--add-drop-table'], null, $dir . '/seed.sql');
    emptyDir($dir . '/uploads');
    copyTree(ROOT_DIR . '/public/uploads', $dir . '/uploads');
    emptyDir($dir . '/private');
    copyTree(ROOT_DIR . '/storage/private', $dir . '/private');
    ok('Demo baseline saved to storage/demo/');
}

function emptyDir(string $dir): void
{
    if (!is_dir($dir)) return;
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::CHILD_FIRST);
    foreach ($it as $item) $item->isDir() ? rmdir($item->getPathname()) : unlink($item->getPathname());
}

function cmdDemoReset(): void
{
    if (!Demo::enabled()) fail('Refusing to reset: DEMO_MODE is not enabled.');
    $seed = demoDir() . '/seed.sql';
    if (!is_file($seed)) fail('No baseline yet — run demo:snapshot first.');

    runMysqlTool('mysql', [], $seed);
    Migrator::migrate(); // a baseline taken before a deploy must not roll the schema back
    ensureDemoUser();    // a baseline taken without the demo login must not lock visitors out
    clearUploads();
    copyTree(demoDir() . '/uploads', ROOT_DIR . '/public/uploads');
    emptyDir(ROOT_DIR . '/storage/private');
    copyTree(demoDir() . '/private', ROOT_DIR . '/storage/private');
    bootCliCache();
    Cache::flush();
    ok('Demo reset to baseline at ' . date('Y-m-d H:i'));
}

/** Sample content so the demo isn't empty. Idempotent: skips entities whose slug exists. */
function cmdDemoSeed(): void
{
    if (!Demo::enabled()) fail('Set DEMO_MODE=true in .env first.');
    $j = fn(array $a) => json_encode($a, JSON_UNESCAPED_UNICODE);
    $admin = (int)DB::getCell('SELECT id FROM user WHERE email = :e', [':e' => strtolower(Demo::login())]);

    $pages = [
        'home' => [
            'title'   => ['en' => 'Welcome to Seven CMS', 'ru' => 'Добро пожаловать в Seven CMS', 'ka' => 'მოგესალმებით Seven CMS-ში'],
            'content' => [
                'en' => '<p>This is a live demo. Open the <a href="/en/admin">admin panel</a>, edit this page, write a post, upload an image or build a product — everything resets every hour.</p>',
                'ru' => '<p>Это живое демо. Откройте <a href="/ru/admin">админку</a>, измените эту страницу, напишите пост, загрузите картинку или создайте товар — всё сбрасывается каждый час.</p>',
                'ka' => '<p>ეს არის ცოცხალი დემო. გახსენით <a href="/ka/admin">ადმინ პანელი</a> — ყველაფერი ყოველ საათში განახლდება.</p>',
            ],
        ],
        'about' => [
            'title'   => ['en' => 'About', 'ru' => 'О проекте', 'ka' => 'ჩვენს შესახებ'],
            'content' => [
                'en' => '<p>Seven CMS is a modular PHP 8 CMS: plugins, custom content types, RBAC, multi-site, e-commerce, REST + GraphQL API, six languages.</p>',
                'ru' => '<p>Seven CMS — модульная CMS на PHP 8: плагины, свои типы контента, роли и права, мультисайт, магазин, REST и GraphQL API, шесть языков.</p>',
                'ka' => '<p>Seven CMS — მოდულური PHP 8 CMS.</p>',
            ],
        ],
    ];
    foreach ($pages as $slug => $p) {
        if (DB::getCell('SELECT COUNT(*) FROM slug WHERE entity_type = "page" AND slug = :s', [':s' => $slug])) continue;
        $page = new Page();
        $page->userId = $admin ?: null;
        $page->title = $j($p['title']);
        $page->content = $j($p['content']);
        $page->isPublished = 1;
        $id = $page->save();
        Slug::saveForEntity('page', (int)$id, ['en' => $slug, 'ru' => $slug, 'ka' => $slug]);
    }

    $catId = (int)DB::getCell('SELECT id FROM category WHERE slug = "news"');
    if (!$catId) {
        $cat = new Category();
        $cat->slug = 'news';
        $cat->name = $j(['en' => 'News', 'ru' => 'Новости', 'ka' => 'სიახლეები']);
        $catId = (int)$cat->save();
    }

    $posts = [
        'hello-seven' => ['Hello, Seven CMS', 'Привет, Seven CMS', 'A first post you are free to edit or delete.', 'Первая запись — можно редактировать или удалить.'],
        'plugins'     => ['Everything is a plugin', 'Всё — плагины', 'Blog, Pages, Media, Shop… switch them on and off under System → Plugins.', 'Блог, страницы, медиа, магазин — включаются и выключаются в Система → Плагины.'],
        'api'         => ['REST and GraphQL out of the box', 'REST и GraphQL из коробки', 'JWT-secured API v1 plus a GraphQL endpoint with a playground.', 'API v1 с JWT и GraphQL с песочницей.'],
    ];
    foreach ($posts as $slug => [$en, $ru, $exEn, $exRu]) {
        if (DB::getCell('SELECT COUNT(*) FROM slug WHERE entity_type = "post" AND slug = :s', [':s' => $slug])) continue;
        $post = new Post();
        $post->userId = $admin ?: null;
        $post->categoryId = $catId;
        $post->title = $j(['en' => $en, 'ru' => $ru]);
        $post->excerpt = $j(['en' => $exEn, 'ru' => $exRu]);
        $post->content = $j(['en' => "<p>{$exEn}</p>", 'ru' => "<p>{$exRu}</p>"]);
        $post->isPublished = 1;
        $post->publishedAt = date('Y-m-d H:i:s');
        $id = $post->save();
        Slug::saveForEntity('post', (int)$id, ['en' => $slug, 'ru' => $slug]);
    }

    $hasTable = fn(string $t) => (bool)DB::getCell('SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = :t', [':t' => $t]);

    // Shop: a few products of every kind, so the storefront, cart and checkout have something to show.
    if ($hasTable('ecom_products')) {
        $cats = [
            'merch'    => ['en' => 'Merch', 'ru' => 'Мерч', 'ka' => 'მერჩი'],
            'digital'  => ['en' => 'Digital', 'ru' => 'Цифровые товары', 'ka' => 'ციფრული'],
            'services' => ['en' => 'Services', 'ru' => 'Услуги', 'ka' => 'სერვისები'],
        ];
        $catIds = [];
        foreach ($cats as $slug => $name) {
            $id = (int)DB::getCell('SELECT id FROM ecom_categories WHERE slug = :s', [':s' => $slug]);
            if (!$id) {
                DB::execute('INSERT INTO ecom_categories (slug, name, description, sort_order, is_active) VALUES (:s, :n, :d, :o, 1)',
                    [':s' => $slug, ':n' => $j($name), ':d' => '{}', ':o' => count($catIds)]);
                $id = (int)DB::getCell('SELECT id FROM ecom_categories WHERE slug = :s', [':s' => $slug]);
            }
            $catIds[$slug] = $id;
        }
        $products = [
            // slug, kind, category, price (minor units), compare-at, name, short description, subscription period
            ['seven-tee', 'physical', 'merch', 2500, 3200, ['en' => 'Seven T-shirt', 'ru' => 'Футболка Seven', 'ka' => 'Seven მაისური'],
                ['en' => 'Soft cotton tee with the Seven logo.', 'ru' => 'Хлопковая футболка с логотипом Seven.'], null],
            ['seven-mug', 'physical', 'merch', 1200, null, ['en' => 'Seven mug', 'ru' => 'Кружка Seven', 'ka' => 'Seven ჭიქა'],
                ['en' => 'Ceramic mug, 330 ml.', 'ru' => 'Керамическая кружка, 330 мл.'], null],
            ['starter-theme', 'digital', 'digital', 4900, null, ['en' => 'Starter theme', 'ru' => 'Стартовая тема', 'ka' => 'საწყისი თემა'],
                ['en' => 'A ready-made theme — delivered as a download link after payment.', 'ru' => 'Готовая тема — ссылка на скачивание после оплаты.'], null],
            ['care-plan', 'service', 'services', 1900, null, ['en' => 'Website care plan', 'ru' => 'Поддержка сайта', 'ka' => 'საიტის მხარდაჭერა'],
                ['en' => 'Monthly updates, backups and fixes — billed every month.', 'ru' => 'Обновления, бэкапы и правки — оплата каждый месяц.'], 'month'],
        ];
        foreach ($products as $i => [$slug, $kind, $cat, $price, $compare, $name, $short, $period]) {
            if (DB::getCell('SELECT COUNT(*) FROM ecom_products WHERE slug = :s', [':s' => $slug])) continue;
            DB::execute(
                'INSERT INTO ecom_products (slug, kind, name, short_description, description, category_id, is_subscription,
                    billing_period, billing_interval, base_price, compare_at_price, sku, track_inventory, stock, tax_class,
                    is_active, is_featured, published_at)
                 VALUES (:slug, :kind, :name, :short, :descr, :cat, :sub, :period, :interval, :price, :compare, :sku,
                    :track, :stock, "standard", 1, :featured, NOW())',
                [
                    ':slug' => $slug, ':kind' => $kind, ':name' => $j($name), ':short' => $j($short),
                    ':descr' => $j(array_map(fn($t) => '<p>' . htmlspecialchars($t) . '</p>', $short)),
                    ':cat' => $catIds[$cat], ':sub' => $period ? 1 : 0, ':period' => $period, ':interval' => $period ? 1 : null,
                    ':price' => $price, ':compare' => $compare, ':sku' => strtoupper(str_replace('-', '', $slug)),
                    ':track' => $kind === 'physical' ? 1 : 0, ':stock' => $kind === 'physical' ? 50 : 0, ':featured' => $i < 2 ? 1 : 0,
                ]
            );
        }
    }

    // Content types: a "Team" type with fields and a few entries, readable at /api/v1/content/team.
    if ($hasTable('content_types')) {
        $typeId = (int)DB::getCell('SELECT id FROM content_types WHERE slug = "team"');
        if (!$typeId) {
            DB::execute('INSERT INTO content_types (slug, name, description, icon) VALUES ("team", "Team", "People shown on the About page", "users")');
            $typeId = (int)DB::getCell('SELECT id FROM content_types WHERE slug = "team"');
            $fields = [['name', 'Name', 'text', 1, 0], ['role', 'Role', 'text', 1, 1], ['bio', 'Bio', 'richtext', 0, 1]];
            foreach ($fields as $o => [$key, $label, $type, $required, $localized]) {
                DB::execute('INSERT INTO content_fields (type_id, `key`, label, field_type, required, localized, settings, sort_order)
                             VALUES (:t, :k, :l, :f, :r, :loc, "{}", :o)',
                    [':t' => $typeId, ':k' => $key, ':l' => $label, ':f' => $type, ':r' => $required, ':loc' => $localized, ':o' => $o]);
            }
        }
        $people = [
            'nino'  => ['Nino Beridze', ['en' => 'Editor', 'ru' => 'Редактор'], ['en' => '<p>Keeps the blog and pages in shape.</p>', 'ru' => '<p>Следит за блогом и страницами.</p>']],
            'giorgi' => ['Giorgi Kapanadze', ['en' => 'Shop manager', 'ru' => 'Менеджер магазина'], ['en' => '<p>Runs the catalog and orders.</p>', 'ru' => '<p>Ведёт каталог и заказы.</p>']],
            'anna'  => ['Anna Petrova', ['en' => 'Developer', 'ru' => 'Разработчик'], ['en' => '<p>Builds themes and plugins.</p>', 'ru' => '<p>Делает темы и плагины.</p>']],
        ];
        $o = 0;
        foreach ($people as $slug => [$name, $role, $bio]) {
            if (DB::getCell('SELECT COUNT(*) FROM content_entries WHERE type_id = :t AND slug = :s', [':t' => $typeId, ':s' => $slug])) continue;
            DB::execute('INSERT INTO content_entries (type_id, slug, status, locale, sort_order, data, author_id, published_at)
                         VALUES (:t, :s, "published", "en", :o, :d, :a, NOW())',
                [':t' => $typeId, ':s' => $slug, ':o' => $o++, ':d' => $j(['name' => $name, 'role' => $role, 'bio' => $bio]), ':a' => $admin ?: null]);
        }
    }
    ok('Demo content seeded.');
}
