# Environment: dev | test | prod
SEVEN_ENV=dev

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=sevencms

# Site
SITE_NAME=SevenCMS
BASE_URL=http://localhost:8085

# Vite — set to true during local development (npm run dev), false in production
VITE_DEV=false

# Cache — driver: file | redis
CACHE_DRIVER=file
CACHE_TTL=3600

# Redis (used only when CACHE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=seven:

# Security
# Required for API v1 / GraphQL tokens. Generate: php bin/sev key:generate
JWT_SECRET=
# Comma-separated IPs of reverse proxies whose X-Forwarded-For / -Proto we trust
# (e.g. 127.0.0.1 when nginx proxies to php-fpm over TCP). Leave empty if none.
TRUSTED_PROXIES=

# Public demo (see docs/demo.md). Never enable on a real site.
DEMO_MODE=false
DEMO_LOGIN=demo@seven.dev
DEMO_PASSWORD=demo1234
